# ─────────────────────────────────────────────
# Digital Kampus — environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────

# ── Clerk (https://dashboard.clerk.com)
# Find these under your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin app only — never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Clerk + Supabase JWT integration
# 1. In Clerk Dashboard → JWT Templates → Add → Supabase
# 2. Copy the Signing Secret from Clerk
# 3. In Supabase → Settings → Auth → JWT Secret → paste the same value
# After this, auth.uid() in RLS policies = Clerk user ID
#
# No extra env var needed — the token is fetched at runtime via:
#   await auth().getToken({ template: 'supabase' })

# ── Mobile (Expo) — same Clerk keys, prefixed with EXPO_PUBLIC_
# Add to apps/mobile/.env.local
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Google Search Console verification (optional)
# NEXT_PUBLIC_GSC_VERIFICATION=replace_with_token
